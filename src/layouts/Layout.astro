---
import CookieConsent from '../components/CookieConsent.astro';
// Fonturile sunt găzduite pe domeniul propriu (pachetele @fontsource, licență
// SIL Open Font License 1.1), nu se mai încarcă de pe serverele Google.
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '@fontsource/plus-jakarta-sans/latin-ext-400.css';
import '@fontsource/plus-jakarta-sans/latin-ext-500.css';
import '@fontsource/plus-jakarta-sans/latin-ext-600.css';
import '@fontsource/plus-jakarta-sans/latin-ext-700.css';
import '@fontsource/plus-jakarta-sans/latin-ext-800.css';
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-300.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-ext-500.css';
import '@fontsource/inter/latin-ext-600.css';
import { langFromPath, alternatePath } from '../i18n/paths';
import { serviceLinks } from '../data/services';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/img/og-default.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  keywords = [],
  jsonLd,
  noindex = false,
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const desc =
  description ??
  (lang === 'en'
    ? 'ME Design: infrastructure design in Romania. Roads, bridges, overpasses, footbridges, retaining structures and slope stabilisation.'
    : 'ME Design - Servicii profesionale de proiectare infrastructură: drumuri, poduri, pasaje, pasarele și lucrări de sprijin și consolidări.');
const canonicalURL = new URL(Astro.url.pathname, 'https://me-design.ro');
const alt = alternatePath(Astro.url.pathname);
const roPath = lang === 'ro' ? Astro.url.pathname : alt;
const enPath = lang === 'en' ? Astro.url.pathname : alt;
const ogImage = new URL(image, 'https://me-design.ro');
// Google afișează ~60 de caractere: la titlurile lungi renunțăm la sufixul de brand.
const fullTitle = title.length + 12 > 65 ? title : `${title} | ME Design`;

// Datele firmei pentru Google și asistenții AI (schema.org), aceleași pe toate
// paginile. Serviciile vin din src/data/services.ts, deci rămân sincronizate.
const SITE = 'https://me-design.ro';
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'ME Design',
      alternateName: 'Mario Engineering Design',
      inLanguage: ['ro-RO', 'en'],
      publisher: { '@id': `${SITE}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'Mario Engineering Design SRL',
      alternateName: 'ME Design',
      legalName: 'Mario Engineering Design SRL',
      url: SITE,
      logo: { '@type': 'ImageObject', url: `${SITE}/img/logo.png` },
      image: `${SITE}/img/og-default.jpg`,
      foundingDate: '2018-12-12',
      taxID: '40290175',
      email: 'office@me-design.ro',
      telephone: '+40746784156',
      address: { '@id': `${SITE}/#address` },
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+40746784156',
        email: 'office@me-design.ro',
        contactType: 'sales',
        areaServed: 'RO',
        availableLanguage: ['Romanian', 'English'],
      },
      sameAs: [],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#localbusiness`,
      name: 'Mario Engineering Design SRL',
      alternateName: 'ME Design',
      description:
        'Proiectare infrastructură în toată România: drumuri, poduri și pasaje, poduri de cale ferată, lucrări de sprijin și consolidări, intervenții la monumente istorice, expertize tehnice și amenajări hidrotehnice. Sisteme de management certificate ISO 9001, ISO 14001 și ISO 45001.',
      url: SITE,
      image: `${SITE}/img/og-default.jpg`,
      logo: `${SITE}/img/logo.png`,
      telephone: '+40746784156',
      email: 'office@me-design.ro',
      foundingDate: '2018-12-12',
      parentOrganization: { '@id': `${SITE}/#organization` },
      address: {
        '@type': 'PostalAddress',
        '@id': `${SITE}/#address`,
        streetAddress: 'Str. Avionului 26, Et. 1, Ap. B',
        addressLocality: 'București',
        addressRegion: 'Sector 1',
        addressCountry: 'RO',
      },
      areaServed: { '@type': 'Country', name: 'România' },
      knowsAbout: serviceLinks.map((x) => x.title),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicii de proiectare infrastructură',
        itemListElement: serviceLinks.map((x) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: x.title, description: x.short, url: `${SITE}/servicii/${x.slug}/` },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Verificare Bing Webmaster Tools. Nu se șterge. -->
    <meta name="msvalidate.01" content="6593442C18BF52906031B36E1E123AC5" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />
    {roPath && enPath && (
      <>
        <link rel="alternate" hreflang="ro" href={new URL(roPath, 'https://me-design.ro')} />
        <link rel="alternate" hreflang="en" href={new URL(enPath, 'https://me-design.ro')} />
        <link rel="alternate" hreflang="x-default" href={new URL(roPath, 'https://me-design.ro')} />
      </>
    )}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Blog ME Design" href="https://me-design.ro/rss.xml" />

    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'ro_RO'} />
    <meta property="og:site_name" content="ME Design" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && <meta property="article:author" content="Mario Engineering Design SRL" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />


    <link rel="stylesheet" href="/vendor/aos/aos.css" />

    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <title>{fullTitle}</title>

    <!-- Google Analytics și Microsoft Clarity: se încarcă DOAR după ce vizitatorul
         apasă „Accept” în bannerul de cookie-uri (CookieConsent.astro). -->
    <script is:inline>
      (function () {
        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', 'G-ZYECGEV54N');
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtag/js?id=G-ZYECGEV54N';
          document.head.appendChild(g);
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', 'vxoibgwub2');
        }
        window.meAnalytics = { load: load };
        try {
          if (localStorage.getItem('medesign_cookie_consent') === 'accepted') load();
        } catch (e) {}
      })();
    </script>

    <style is:global>
      *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        color: #1e293b;
        line-height: 1.6;
        overflow-x: hidden;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        line-height: 1.2;
      }

      /* Stil Apple: bara de sus din material translucid, butoane-pastilă
         cu răspuns la apăsare, contur de focus vizibil doar la tastatură. */
      #header {
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
      }
      #header.header-glass {
        background: rgba(255, 255, 255, 0.72);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        backdrop-filter: saturate(180%) blur(20px);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
      }
      @media (prefers-reduced-transparency: reduce) {
        #header.header-glass { background: #fff; backdrop-filter: none; }
      }

      a.rounded-full,
      button.rounded-full {
        -webkit-tap-highlight-color: transparent;
        transition-property: color, background-color, border-color, opacity, scale;
        transition-duration: 0.2s;
        transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
      }
      a.rounded-full:active,
      button.rounded-full:active:not(:disabled) {
        scale: 0.97;
        transition-duration: 0.1s;
      }
      @media (prefers-reduced-motion: reduce) {
        a.rounded-full:active,
        button.rounded-full:active { scale: 1; }
      }

      :focus-visible {
        outline: 2px solid #d97706;
        outline-offset: 3px;
      }
      :focus:not(:focus-visible) { outline: none; }

      .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
      }

      .glass-dark {
        background: rgba(30, 58, 95, 0.05);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(30, 58, 95, 0.1);
      }

      .gradient-text {
        background: linear-gradient(135deg, #1e3a5f, #d97706);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .section-padding {
        padding: 3rem 0;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Blueprint grid animation */
      @keyframes drawGrid {
        0% { opacity: 0; stroke-dashoffset: 1000; }
        50% { opacity: 0.06; }
        100% { opacity: 0.06; stroke-dashoffset: 0; }
      }

      @keyframes drawPath {
        to { stroke-dashoffset: 0; }
      }

      @keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes fadeSlideRight {
        from { opacity: 0; transform: translateX(-30px); }
        to { opacity: 1; transform: translateX(0); }
      }

      @keyframes countPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
      }

      @keyframes shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
      }

      @keyframes floatSlow {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        33% { transform: translateY(-15px) rotate(1deg); }
        66% { transform: translateY(-8px) rotate(-1deg); }
      }

      @keyframes progressLine {
        from { width: 0; }
        to { width: 100%; }
      }

      @keyframes rotateShape {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      @keyframes morphBlob {
        0%, 100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
        50% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }
      }

      .animate-draw-path {
        animation: drawPath 2s ease-out forwards;
      }

      .animate-float-slow {
        animation: floatSlow 8s ease-in-out infinite;
      }

      .animate-morph {
        animation: morphBlob 8s ease-in-out infinite;
      }

      .animate-rotate-slow {
        animation: rotateShape 30s linear infinite;
      }

      .animate-shimmer {
        background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.1) 50%, transparent 100%);
        background-size: 200% 100%;
        animation: shimmer 3s ease-in-out infinite;
      }

      /* Tilt card effect */
      .tilt-card {
        transform-style: preserve-3d;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .tilt-card:hover {
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.12);
      }

      .tilt-card .tilt-inner {
        transform: translateZ(30px);
      }

      /* Counter animation glow */
      .counter-glow {
        text-shadow: 0 0 40px rgba(217, 119, 6, 0.3);
      }

      /* Timeline connector */
      .timeline-connector {
        position: relative;
      }

      .timeline-connector::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 100%;
        width: calc(100% - 2rem);
        height: 2px;
        background: linear-gradient(90deg, #d97706, #1e3a5f);
        opacity: 0;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.8s ease, opacity 0.3s;
      }

      .timeline-connector.animated::after {
        opacity: 0.3;
        transform: scaleX(1);
      }

      /* Parallax container */
      .parallax-layer {
        will-change: transform;
        transition: transform 0.1s linear;
      }

      /* Hero photo parallax */
      .hero-parallax {
        will-change: transform;
        transition: transform 0.15s ease-out;
      }

      /* Hero blueprint grid fade in */
      .hero-grid-fade {
        opacity: 0;
        animation: fadeInSlow 2s ease-out 1s forwards;
      }

      @keyframes fadeInSlow {
        to { opacity: 1; }
      }

      /* Hero road trace */
      .hero-trace {
        animation: drawHeroTrace 3s ease-out 1.5s forwards;
      }

      .hero-trace-2 {
        animation: drawHeroTrace 2.5s ease-out 2s forwards;
      }

      @keyframes drawHeroTrace {
        to { stroke-dashoffset: 0; }
      }

      /* Hero annotations */
      .hero-annotation {
        opacity: 0;
        animation: fadeSlideAnnotation 0.8s ease-out forwards;
        animation-delay: var(--delay, 3s);
      }

      @keyframes fadeSlideAnnotation {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* Cross section panel */
      .hero-cross-section {
        opacity: 0;
        transform: translateX(30px);
        animation: slideInPanel 0.8s ease-out 4.5s forwards;
      }

      @keyframes slideInPanel {
        to { opacity: 1; transform: translateX(0); }
      }

      /* Road plan view layers - draw in */
      .road-layer {
        stroke-dasharray: 1200;
        stroke-dashoffset: 1200;
        opacity: 0;
        animation: drawRoadLayer 2s ease-out forwards;
        animation-delay: var(--delay, 1s);
      }

      @keyframes drawRoadLayer {
        0% { stroke-dashoffset: 1200; opacity: 0; }
        10% { opacity: 1; }
        100% { stroke-dashoffset: 0; opacity: 1; }
      }

      .road-text {
        opacity: 0;
        animation: fadeInText 0.6s ease-out forwards;
        animation-delay: var(--delay, 1s);
      }

      @keyframes fadeInText {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      /* Cross section layers - reveal from bottom up */
      .layer-reveal {
        opacity: 0;
        transform-origin: center bottom;
        animation: revealLayer 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: var(--delay, 1s);
      }

      @keyframes revealLayer {
        0% { opacity: 0; transform: translateY(8px) scaleY(0.8); }
        100% { opacity: 1; transform: translateY(0) scaleY(1); }
      }

      /* Next-page navigation bar */
      @keyframes navSlideUp {
        from { opacity: 0; transform: translateY(32px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      @keyframes arrowBounce {
        0%, 100% { transform: translateX(0); }
        50%       { transform: translateX(6px); }
      }

      .next-nav {
        opacity: 0;
        transform: translateY(32px);
      }

      .next-nav.is-visible {
        animation: navSlideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      .next-nav-arrow {
        animation: arrowBounce 1.1s ease-in-out infinite;
      }
    </style>

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteGraph)} />

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}

  </head>
  <body class="bg-white">
    <slot />
    <CookieConsent lang={lang} />

    <script is:inline src="/vendor/aos/aos.js"></script>
    <script is:inline>
      AOS.init({
        duration: 700,
        once: true,
        offset: 50,
        easing: 'ease-out-cubic',
      });
    </script>
    <script is:inline>
      (function() {
        var nav = document.querySelector('.next-nav');
        if (!nav) return;
        var observer = new IntersectionObserver(function(entries) {
          if (entries[0].isIntersecting) {
            entries[0].target.classList.add('is-visible');
            observer.disconnect();
          }
        }, { threshold: 0.3 });
        observer.observe(nav);
      })();
    </script>
  <!-- Cloudflare Web Analytics -->
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "bdb3f1be23d14cee9307a78d57f3bf39"}'></script>
  <!-- End Cloudflare Web Analytics -->
  </body>
</html>
