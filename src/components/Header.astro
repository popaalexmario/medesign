---
import { serviceLinks } from '../data/services';
import { serviceLinksEn } from '../data/services.en';
import { regions } from '../data/regions';
import { langFromPath, switchLink } from '../i18n/paths';

const normalize = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));

const lang = langFromPath(currentPath);
const en = lang === 'en';
const home = en ? '/en/' : '/';
const servicesHref = en ? '/en/services' : '/servicii';
const portfolioHref = en ? '/en/portfolio' : '/portofoliu';
const contactHref = en ? '/en/contact' : '/contact';
const links = en ? serviceLinksEn : serviceLinks;
const otherLang = { href: switchLink(currentPath), label: en ? 'RO' : 'EN', title: en ? 'Versiunea în română' : 'English version', hreflang: en ? 'ro' : 'en' };

const navItems = en
  ? [
      { label: 'Services', href: servicesHref },
      { label: 'Portfolio', href: portfolioHref },
      { label: 'About', href: '/en/about' },
      { label: 'Contact', href: contactHref },
    ]
  : [
      { label: 'Servicii', href: servicesHref },
      { label: 'Portofoliu', href: portfolioHref },
      { label: 'Blog', href: '/blog' },
      { label: 'Despre noi', href: '/despre' },
      { label: 'Contact', href: contactHref },
    ];

// Serviciile din dropdown, grupate pe trei coloane.
const svc = (slug: string) => links.find((s) => s.slug === slug)!;
const serviceGroups = [
  { title: en ? 'Roads and bridges' : 'Drumuri și poduri', items: ['proiectare-drumuri', 'proiectare-poduri-pasaje', 'poduri-cale-ferata'].map(svc) },
  { title: en ? 'Retaining and water' : 'Consolidări și ape', items: ['lucrari-consolidare', 'amenajari-hidrotehnice'].map(svc) },
  { title: en ? 'Assessment and heritage' : 'Expertiză și patrimoniu', items: ['expertize-tehnice', 'monumente-istorice'].map(svc) },
];
const portfolioLinks = en
  ? [{ label: 'All projects', href: portfolioHref, strong: true }]
  : [
      { label: 'Toate proiectele', href: '/portofoliu', strong: true },
      ...regions.map((r) => ({ label: r.name, href: `/zone/${r.id}`, strong: false })),
      { label: 'Colaborări', href: '/colaborari', strong: false },
    ];
const t = en
  ? { homeLabel: 'ME Design, home page', tagline: 'Infrastructure Design', svcNote: 'Complete design, from site investigations to technical assistance during construction.', allSvc: 'All services →', byRegion: 'Projects', cta: 'Request a quote', menu: 'Menu' }
  : { homeLabel: 'ME Design, prima pagină', tagline: 'Proiectare Infrastructură', svcNote: 'Proiectare completă, de la studii de teren la asistență tehnică pe șantier.', allSvc: 'Toate serviciile →', byRegion: 'Proiecte pe regiuni', cta: 'Solicită ofertă', menu: 'Meniu' };
const chevron = '<svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>';
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="container">
    <nav class="flex items-center justify-between h-20">
      <a href={home} class="flex items-center gap-3 group" aria-label={t.homeLabel}>
        <div>
          <span class="font-heading font-bold text-xl text-brand-500">ME Design</span>
          <span class="hidden sm:block text-[11px] text-steel-400 font-medium tracking-wider uppercase -mt-1">{t.tagline}</span>
        </div>
      </a>

      <div class="hidden lg:flex items-center gap-8">
        {navItems.map((item) => {
          const linkCls = [
            'inline-flex items-center gap-1.5 text-[15px] font-medium transition-colors hover:text-accent-500 py-7',
            isActive(item.href) ? 'text-accent-500' : 'text-steel-600',
          ];
          if (item.href === servicesHref) return (
            <div class="relative group" data-dropdown>
              <a href={item.href} class:list={linkCls} aria-haspopup="true">{item.label}<Fragment set:html={chevron} /></a>
              <div class="dropdown-panel absolute left-1/2 top-full -translate-x-1/2 pt-1 w-[760px] max-w-[90vw]">
                <div class="bg-white rounded-2xl shadow-2xl shadow-brand-900/15 border border-steel-100 p-6">
                  <div class="grid grid-cols-3 gap-6">
                    {serviceGroups.map((g) => (
                      <div>
                        <p class="text-accent-600 text-[11px] font-semibold uppercase tracking-[0.18em] pb-3 mb-2 border-b border-steel-100">{g.title}</p>
                        <ul class="space-y-0.5">
                          {g.items.map((s) => (
                            <li>
                              <a href={`${servicesHref}/${s.slug}`} class:list={['block rounded-lg px-3 py-2 -mx-3 hover:bg-steel-50 transition-colors', isActive(`${servicesHref}/${s.slug}`) && 'bg-steel-50']}>
                                <span class="block text-[14px] font-semibold text-brand-800">{s.title}</span>
                                <span class="block text-[12.5px] text-steel-500 mt-0.5">{s.short}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                  <div class="mt-5 pt-4 border-t border-steel-100 flex items-center justify-between text-[13px]">
                    <span class="text-steel-500">{t.svcNote}</span>
                    <a href={servicesHref} class="font-semibold text-accent-600 hover:text-accent-700 whitespace-nowrap">{t.allSvc}</a>
                  </div>
                </div>
              </div>
            </div>
          );
          if (item.href === portfolioHref) return (
            <div class="relative group" data-dropdown>
              <a href={item.href} class:list={linkCls} aria-haspopup="true">{item.label}<Fragment set:html={chevron} /></a>
              <div class="dropdown-panel absolute left-1/2 top-full -translate-x-1/2 pt-1 w-[260px]">
                <div class="bg-white rounded-2xl shadow-2xl shadow-brand-900/15 border border-steel-100 p-3">
                  <p class="text-accent-600 text-[11px] font-semibold uppercase tracking-[0.18em] px-3 pt-2 pb-2">{t.byRegion}</p>
                  <ul>
                    {portfolioLinks.map((l) => (
                      <li>
                        <a href={l.href} class:list={['block rounded-lg px-3 py-2 text-[14px] hover:bg-steel-50 transition-colors', l.strong ? 'font-semibold text-brand-800' : 'text-steel-600', isActive(l.href) && 'bg-steel-50']}>{l.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          );
          return <a href={item.href} class:list={linkCls}>{item.label}</a>;
        })}
        <a href={otherLang.href} hreflang={otherLang.hreflang} title={otherLang.title} class="text-[13px] font-semibold tracking-wider text-steel-500 hover:text-accent-500 border border-steel-200 rounded-full px-3 py-1.5 transition-colors">{otherLang.label}</a>
        <a href={contactHref} class="bg-brand-500 text-white px-5 py-2 rounded-full text-[14px] font-semibold hover:bg-brand-600">
          {t.cta}
        </a>
      </div>

      <div class="lg:hidden flex items-center gap-2">
      <a href={otherLang.href} hreflang={otherLang.hreflang} title={otherLang.title} class="text-[13px] font-semibold tracking-wider text-steel-500 border border-steel-200 rounded-full px-3 py-1.5">{otherLang.label}</a>
      <button id="menu-toggle" class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-steel-100 transition-colors" aria-label={t.menu}>
        <svg class="w-6 h-6 text-steel-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      </div>
    </nav>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden bg-white border-t border-steel-100 shadow-xl">
    <div class="container pt-4 pb-8 flex flex-col gap-1">
      {navItems.map((item) => (
        <>
          <a
            href={item.href}
            class:list={[
              'px-4 py-3 rounded-xl text-[15px] font-medium transition-colors',
              isActive(item.href) ? 'bg-brand-50 text-accent-500' : 'text-steel-600 hover:bg-steel-50',
            ]}
          >
            {item.label}
          </a>
          {item.href === servicesHref && (
            <div class="ml-4 mb-1 pl-3 border-l-2 border-steel-100 flex flex-col">
              {links.map((s) => (
                <a href={`${servicesHref}/${s.slug}`} class="px-3 py-2 rounded-lg text-[14px] text-steel-500 hover:bg-steel-50 hover:text-accent-500">{s.title}</a>
              ))}
            </div>
          )}
        </>
      ))}
      <a href={contactHref} class="mt-2 bg-brand-500 text-white px-6 py-3 rounded-full text-center text-[14px] font-semibold hover:bg-brand-600 transition-colors">
        {t.cta}
      </a>
    </div>
  </div>
</header>

<style>
  /* Dropdown-urile se deschid la trecerea mouse-ului (și la focus, pentru tastatură). */
  .dropdown-panel {
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
  }
  [data-dropdown]:hover > .dropdown-panel,
  [data-dropdown]:focus-within > .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s;
  }
</style>

<script is:inline>
  const header = document.getElementById('header');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  let isOpen = false;

  menuToggle.addEventListener('click', () => {
    isOpen = !isOpen;
    mobileMenu.classList.toggle('hidden', !isOpen);
    const icon = document.getElementById('menu-icon');
    icon.setAttribute('d', isOpen ? 'M6 18L18 6M6 6l12 12' : 'M4 6h16M4 12h16M4 18h16');
  });

  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    if (scrollY > 50) {
      header.classList.add('header-glass');
    } else {
      header.classList.remove('header-glass');
    }
    lastScroll = scrollY;
  });
</script>
