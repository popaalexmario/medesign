---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { clienti } from '../data/clienti';

// poze/logouri/<id>/: un fișier urcat de Mario are prioritate față de
// _site-oficial.png (logoul descărcat de noi). Folder gol = doar numele.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/poze/logouri/*/*.{png,jpg,jpeg,webp,svg,PNG,JPG,JPEG,WEBP,SVG}',
  { eager: true }
);
const byId: Record<string, { name: string; img: ImageMetadata }[]> = {};
for (const [path, mod] of Object.entries(files)) {
  const [, , , id, name] = path.split('/');
  (byId[id] ??= []).push({ name, img: mod.default });
}
const pick = (id: string) => {
  const list = (byId[id] ?? []).sort((a, b) => a.name.localeCompare(b.name));
  return (list.find((f) => !f.name.startsWith('_')) ?? list[0])?.img;
};

const items = await Promise.all(
  clienti.map(async (c) => {
    const img = pick(c.id);
    if (!img) return { ...c, src: undefined };
    const out = img.format === 'svg'
      ? { src: img.src }
      : await getImage({ src: img, height: Math.min(160, img.height), format: 'webp' });
    return { ...c, src: out.src };
  })
);

interface Props {
  /** false = fără titlu (când secțiunea din jur are deja unul) */
  title?: string | false;
  /** dark: bandă proprie pe fundal închis; light: în interiorul unei secțiuni deschise */
  variant?: 'dark' | 'light';
}
const { title = 'Beneficiari și parteneri ai proiectelor noastre', variant = 'dark' } = Astro.props;
const dark = variant === 'dark';
const fade = dark ? 'from-brand-900' : 'from-steel-50';
---

<section class:list={['overflow-hidden', dark ? 'py-12 md:py-14 bg-brand-900' : 'py-2']} aria-label={title || 'Beneficiari și parteneri'}>
  {title && (
    <div class="container">
      <h2 class="text-white/90 font-heading font-bold text-[18px] md:text-[20px] mb-8">{title}</h2>
    </div>
  )}
  <div class="marquee group relative">
    <div class="marquee-track flex w-max items-center group-hover:[animation-play-state:paused]">
      {[0, 1].map((copy) => (
        <ul class="flex items-center shrink-0" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((c) => (
            <li class="shrink-0 w-[200px] px-3 flex flex-col items-center text-center">
              <div class:list={['w-[176px] h-[88px] rounded-xl bg-white flex items-center justify-center p-3', dark ? 'shadow-sm' : 'border border-steel-100 shadow-sm']}>
                {c.src ? (
                  <img src={c.src} alt={copy === 0 ? c.name : ''} class="max-h-full max-w-full object-contain" loading="lazy" />
                ) : (
                  <span class="text-brand-800 font-heading font-extrabold text-[15px] leading-tight">{c.name.split(',')[0]}</span>
                )}
              </div>
              <span class:list={['mt-3 text-[12px] leading-snug min-h-[2.6em]', dark ? 'text-white/65' : 'text-steel-500']}>{c.name}</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
    <div class:list={['pointer-events-none absolute inset-y-0 left-0 w-16 md:w-32 bg-gradient-to-r to-transparent', fade]}></div>
    <div class:list={['pointer-events-none absolute inset-y-0 right-0 w-16 md:w-32 bg-gradient-to-l to-transparent', fade]}></div>
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee 55s linear infinite;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
    .marquee { overflow-x: auto; }
  }
</style>
