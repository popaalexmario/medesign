---
// Secțiune „Întrebări frecvente” vizibilă; aceleași texte merg în schema FAQPage a paginii.
import type { Faq } from '../data/faq';
interface Props { items: Faq[]; bg?: string; id?: string }
const { items, bg = 'bg-page', id = 'intrebari' } = Astro.props;
---

<section class={`section-padding ${bg}`} id={id}>
  <div class="container max-w-3xl">
    <h2 class="text-[28px] md:text-[40px] font-heading font-bold text-brand-800 text-center">Întrebări frecvente</h2>
    <div class="mt-8 space-y-3">
      {items.map((f, i) => (
        <details class="group bg-white rounded-2xl border border-steel-100 px-5 md:px-6 py-4" open={i === 0}>
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <h3 class="font-heading font-bold text-[16px] md:text-[17px] text-brand-800">{f.q}</h3>
            <span class="shrink-0 mt-1 text-accent-600 transition-transform group-open:rotate-45 text-[20px] leading-none" aria-hidden="true">+</span>
          </summary>
          <p class="text-steel-600 text-[15px] leading-relaxed mt-3">{f.a}</p>
          {f.href && <a href={f.href} class="inline-block mt-2 text-accent-700 font-semibold text-[14px] hover:underline">Detalii →</a>}
        </details>
      ))}
    </div>
    <slot />
  </div>
</section>
