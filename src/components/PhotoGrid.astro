---
import type { Photo } from '../utils/autoGallery';

interface Props {
  photos: Photo[];
  alt: string;
  title?: string;
}

const { photos, alt, title = 'Imagini din proiect' } = Astro.props;
---

{photos.length > 0 && (
  <div class="mt-10 not-prose">
    <h2 class="text-[20px] font-heading font-bold text-brand-800 mb-4">{title}</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {photos.map((p) => (
        <figure class="rounded-2xl overflow-hidden border border-steel-100 cursor-zoom-in" data-lightbox>
          <img
            src={p.thumb}
            data-full={p.full}
            alt={p.caption ?? alt}
            class="w-full aspect-[4/3] object-cover hover:scale-105 transition-transform duration-500"
            loading="lazy"
            width="800"
            height="600"
          />
          {p.caption && <figcaption class="text-steel-500 text-[13px] p-3">{p.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
)}
