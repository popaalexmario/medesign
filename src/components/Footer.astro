---
const currentYear = new Date().getFullYear();

import { serviceLinks } from '../data/services';
import { serviceLinksEn } from '../data/services.en';
import { langFromPath } from '../i18n/paths';
import CopyEmail from './CopyEmail.astro';

const en = langFromPath(Astro.url.pathname) === 'en';

const services = (en ? serviceLinksEn : serviceLinks).map((s) => ({
  label: s.title,
  href: `${en ? '/en/services' : '/servicii'}/${s.slug}`,
}));

const links = en
  ? [
      { label: 'About us', href: '/en/about' },
      { label: 'Portfolio', href: '/en/portfolio' },
      { label: 'Contact', href: '/en/contact' },
      { label: 'Versiunea în română', href: '/' },
    ]
  : [
      { label: 'Despre noi', href: '/despre' },
      { label: 'Portofoliu', href: '/portofoliu' },
      { label: 'Zone acoperite', href: '/zone' },
      { label: 'Colaborări', href: '/colaborari' },
      { label: 'Blog', href: '/blog' },
      { label: 'Contact', href: '/contact' },
      { label: 'English version', href: '/en/' },
    ];

const t = en
  ? { about: 'Mario Engineering Design SRL, infrastructure design in Romania: roads, bridges, retaining structures and slope stabilisation, from feasibility to site assistance.', services: 'Services', company: 'Company', country: 'Bucharest, Romania', rights: 'All rights reserved.', terms: 'Terms and conditions (RO)', privacy: 'Privacy policy (RO)', cookies: 'Cookie policy (RO)', mail: 'mailto:office@me-design.ro?subject=Project%20enquiry' }
  : { about: 'Mario Engineering Design SRL, proiectare infrastructură în România. Servicii profesionale cu experiență dovedită în proiecte de anvergură.', services: 'Servicii', company: 'Companie', country: 'România', rights: 'Toate drepturile rezervate.', terms: 'Termeni și Condiții', privacy: 'Politica de Confidențialitate', cookies: 'Politica de Cookies', mail: 'mailto:office@me-design.ro?subject=Solicitare%20oferta%20proiect&body=Buna%20ziua%2C%0A%0ADorim%20sa%20va%20contactam%20pentru%20un%20proiect%20de%20infrastructura.%0A%0AVa%20rugam%20sa%20ne%20contactati.%0A%0AMultumim!' };
---

<footer class="bg-brand-900 text-white">
  <div class="container">
    <div class="py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <div class="lg:col-span-1">
        <div class="mb-4">
          <img src="/img/logo.png" alt="Mario Engineering Design SRL" class="h-14 w-auto object-contain" />
        </div>
        <p class="text-white/50 text-[14px] leading-relaxed max-w-xs">
          {t.about}
        </p>
      </div>

      <div>
        <h4 class="font-heading font-semibold text-[15px] mb-4 text-white/80 uppercase tracking-wider">{t.services}</h4>
        <ul class="space-y-1.5 md:space-y-2.5">
          {services.map((item) => (
            <li>
              <a href={item.href} class="inline-block py-1 md:py-0 text-white/50 hover:text-accent-400 text-[14px] transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-heading font-semibold text-[15px] mb-4 text-white/80 uppercase tracking-wider">{t.company}</h4>
        <ul class="space-y-1.5 md:space-y-2.5">
          {links.map((item) => (
            <li>
              <a href={item.href} class="inline-block py-1 md:py-0 text-white/50 hover:text-accent-400 text-[14px] transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-heading font-semibold text-[15px] mb-4 text-white/80 uppercase tracking-wider">Contact</h4>
        <ul class="space-y-3 text-[14px]">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-white/50">{t.country}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="flex flex-wrap items-center gap-2"><a href={t.mail} class="text-white/50 hover:text-accent-400 transition-colors">office@me-design.ro</a><CopyEmail tone="dark" class="!px-2.5 !py-1 !text-[12px]" /></span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+40746784156" class="text-white/50 hover:text-accent-400 transition-colors">+40 746 784 156</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white/30 text-[13px] text-center sm:text-left">
        &copy; {currentYear} Mario Engineering Design SRL. {t.rights}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1">
        <a href="/termeni-si-conditii" class="py-2 sm:py-0 text-white/30 hover:text-white/60 text-[13px] transition-colors whitespace-nowrap">{t.terms}</a>
        <a href="/politica-de-confidentialitate" class="py-2 sm:py-0 text-white/30 hover:text-white/60 text-[13px] transition-colors whitespace-nowrap">{t.privacy}</a>
        <a href="/politica-cookies" class="py-2 sm:py-0 text-white/30 hover:text-white/60 text-[13px] transition-colors whitespace-nowrap">{t.cookies}</a>
        <button type="button" data-cookie-settings class="py-2 sm:py-0 text-white/30 hover:text-white/60 text-[13px] transition-colors whitespace-nowrap">{en ? 'Cookie settings' : 'Setări cookie-uri'}</button>
      </div>
    </div>
  </div>
</footer>
