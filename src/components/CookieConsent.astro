---
interface Props { lang?: 'ro' | 'en' }
const en = Astro.props.lang === 'en';
---

<!-- Banner de consimțământ. Nimic din ce trimite date către terți (Google
     Analytics, Microsoft Clarity) nu pornește înainte de
     „Accept”. „Refuz” are aceeași greutate vizuală ca „Accept”. -->
<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-[9999] hidden"
  role="dialog"
  aria-label={en ? 'Cookie consent' : 'Consimțământ cookie-uri'}
>
  <div class="bg-white border-t border-gray-200 shadow-2xl">
    <div class="container mx-auto px-4 sm:px-6 py-3 sm:py-4 max-w-[1200px] pb-[max(0.75rem,env(safe-area-inset-bottom))]">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-4">
        <div class="flex items-start gap-3 flex-1">
          <div class="mt-0.5 shrink-0 w-8 h-8 hidden sm:flex bg-accent-500 rounded-lg items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <p class="text-[13px] sm:text-sm text-gray-700 leading-snug sm:leading-relaxed">
            {en
              ? 'With your consent we use Google Analytics and Microsoft Clarity to see how the site is used. Neither loads until you accept. Details in the '
              : 'Cu acordul tău folosim Google Analytics și Microsoft Clarity ca să vedem cum e folosit site-ul. Niciunul nu se încarcă până nu accepți. Detalii în '}
            <a href="/politica-cookies" class="text-accent-600 hover:text-accent-700 underline underline-offset-2 font-medium">{en ? 'Cookie Policy (in Romanian)' : 'Politica de Cookies'}</a>.
          </p>
        </div>
        <div class="flex items-center gap-3 shrink-0 w-full sm:w-auto">
          <button id="cookie-decline" class="flex-1 sm:flex-none px-5 py-2.5 text-sm font-semibold text-brand-800 bg-steel-100 rounded-full hover:bg-steel-200">
            {en ? 'Decline' : 'Refuz'}
          </button>
          <button id="cookie-accept" class="flex-1 sm:flex-none px-5 py-2.5 text-sm font-semibold text-white bg-brand-500 rounded-full hover:bg-brand-600">
            Accept
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'medesign_cookie_consent';
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;

    function get() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function set(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
    function show() { banner.style.opacity = '1'; banner.style.display = 'block'; }
    function hide() {
      banner.style.transition = 'opacity 0.3s ease';
      banner.style.opacity = '0';
      setTimeout(function () { banner.style.display = 'none'; }, 300);
    }
    function announce(v) {
      try { window.dispatchEvent(new CustomEvent('medesign:consent', { detail: v })); } catch (e) {}
    }
    // La retragerea acordului: șterge cookie-urile de analiză deja puse.
    function clearAnalyticsCookies() {
      var names = document.cookie.split(';').map(function (c) { return c.split('=')[0].trim(); });
      var host = location.hostname.replace(/^www\./, '');
      names.forEach(function (n) {
        if (/^(_ga|_gid|_gat|_clck|_clsk|CLID|ANONCHK|MR|MUID|SM)/.test(n)) {
          ['', '; domain=' + host, '; domain=.' + host].forEach(function (d) {
            document.cookie = n + '=; Max-Age=0; path=/' + d;
          });
        }
      });
    }

    if (!get()) show();

    document.getElementById('cookie-accept').addEventListener('click', function () {
      set('accepted');
      hide();
      if (window.meAnalytics) window.meAnalytics.load();
      announce('accepted');
    });

    document.getElementById('cookie-decline').addEventListener('click', function () {
      var wasAccepted = get() === 'accepted';
      set('declined');
      hide();
      announce('declined');
      if (wasAccepted) {
        clearAnalyticsCookies();
        location.reload();
      }
    });

    // Linkul „Setări cookie-uri” din subsol redeschide bannerul.
    window.meCookieSettings = show;
    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest && e.target.closest('[data-cookie-settings]');
      if (t) { e.preventDefault(); show(); }
    });
  })();
</script>
