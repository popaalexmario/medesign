---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { servicePages, serviceLinks, type ServicePage } from '../../data/services';

export async function getStaticPaths() {
  return servicePages.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

type Props = { service: ServicePage };

const { service } = Astro.props;
const altele = serviceLinks.filter((s) => s.slug !== service.slug);
const url = `https://me-design.ro/servicii/${service.slug}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${url}#service`,
    name: service.title,
    description: service.description,
    provider: { '@id': 'https://me-design.ro/#organization' },
    areaServed: { '@type': 'Country', name: 'România' },
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Acasă', item: 'https://me-design.ro' },
      { '@type': 'ListItem', position: 2, name: 'Servicii', item: 'https://me-design.ro/servicii' },
      { '@type': 'ListItem', position: 3, name: service.title, item: url },
    ],
  },
];
---

<Layout title={service.title} description={service.description} keywords={service.keywords} image={service.image} jsonLd={jsonLd}>
  <Header />

  <section class="pt-28 pb-8 bg-gradient-to-br from-brand-900 to-brand-700">
    <div class="container">
      <nav class="flex items-center gap-2 text-white/50 text-[13px] mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Acasă</a>
        <span>/</span>
        <a href="/servicii" class="hover:text-white transition-colors">Servicii</a>
        <span>/</span>
        <span class="text-white">{service.title}</span>
      </nav>
      <span class="text-accent-400 font-semibold text-[13px] uppercase tracking-widest" data-aos="fade-up">Serviciu</span>
      <h1 class="text-[36px] md:text-[52px] font-heading font-extrabold text-white mt-3 leading-tight" data-aos="fade-up" data-aos-delay="50" set:html={service.h1} />
      <p class="text-white/60 text-[17px] mt-4 max-w-2xl" data-aos="fade-up" data-aos-delay="100">{service.lead}</p>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-8">
          {service.image && (
            <div data-aos="fade-up">
              <img src={service.image} alt={service.imageAlt ?? service.title} class="w-full rounded-2xl object-cover max-h-72" width="768" height="288" />
            </div>
          )}

          <div data-aos="fade-up">
            {service.intro.map((p, i) => (
              <p class:list={['text-steel-500 text-[15px] leading-relaxed', i < service.intro.length - 1 && 'mb-4']}>{p}</p>
            ))}
          </div>

          <div data-aos="fade-up">
            <h2 class="text-[22px] font-heading font-bold text-brand-800 mb-4">{service.lucrariTitlu}</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {service.lucrari.map((item) => (
                <div class="bg-steel-50 rounded-2xl p-5 border border-steel-100">
                  <div class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-accent-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <div>
                      <p class="font-semibold text-brand-800 text-[14px]">{item.title}</p>
                      <p class="text-steel-500 text-[13px] mt-1">{item.desc}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {service.experienta && service.experienta.length > 0 && (
            <div data-aos="fade-up">
              <h2 class="text-[22px] font-heading font-bold text-brand-800 mb-4">Din experiența noastră</h2>
              <div class="space-y-4">
                {service.experienta.map((e) => (
                  <div class="border border-steel-100 rounded-2xl p-5">
                    <h3 class="font-heading font-bold text-brand-800 text-[16px]">{e.titlu}</h3>
                    <p class="text-steel-500 text-[14px] mt-2 leading-relaxed">{e.text}</p>
                    <a href={e.href} class="inline-flex items-center gap-2 text-accent-600 hover:text-accent-700 font-semibold text-[14px] mt-3 group">
                      {e.link}
                      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div data-aos="fade-up">
            <h2 class="text-[22px] font-heading font-bold text-brand-800 mb-4">Întrebări frecvente</h2>
            <div class="space-y-4">
              {service.faq.map((item) => (
                <div class="border border-steel-100 rounded-2xl p-5">
                  <p class="font-semibold text-brand-800 text-[15px] mb-2">{item.q}</p>
                  <p class="text-steel-500 text-[14px] leading-relaxed">{item.a}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="space-y-6" data-aos="fade-up">
          <div class="bg-brand-900 rounded-3xl p-6 text-white sticky top-28">
            <h2 class="font-heading font-bold text-[18px] mb-2">Solicită o consultanță gratuită</h2>
            <p class="text-white/60 text-[14px] mb-5">Contactează-ne pentru o evaluare a proiectului tău.</p>
            <a href="/contact" class="block text-center bg-accent-500 hover:bg-accent-600 text-white px-6 py-3 rounded-full font-semibold text-[14px] transition-all">
              Discută proiectul tău
            </a>
            <div class="mt-5 pt-5 border-t border-white/10 space-y-3">
              <a href="tel:+40746784156" class="flex items-center gap-3 text-white/70 hover:text-white text-[14px] transition-colors">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                +40 746 784 156
              </a>
              <a href="mailto:office@me-design.ro" class="flex items-center gap-3 text-white/70 hover:text-white text-[14px] transition-colors">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                office@me-design.ro
              </a>
            </div>
          </div>

          <div class="bg-steel-50 rounded-3xl p-6">
            <h2 class="font-heading font-bold text-brand-800 text-[16px] mb-4">Alte servicii</h2>
            <div class="space-y-3">
              {altele.map((s) => (
                <a href={`/servicii/${s.slug}`} class="flex items-start gap-3 text-steel-600 hover:text-brand-600 text-[14px] transition-colors group">
                  <svg class="w-4 h-4 shrink-0 mt-0.5 text-brand-400 group-hover:text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                  {s.title}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
