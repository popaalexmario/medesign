---
// Galerie de variante pentru prima pagină: paletă de culori + fundal animat +
// fotografie. Pagină ascunsă (noindex, scoasă din sitemap); Mario alege de aici.
// Textele sunt cele de pe prima pagină actuală, neschimbate.
import Layout from '../layouts/Layout.astro';

// Curbe de nivel (ca pe un plan topografic), generate o singură dată la build.
const contour = (k: number) => {
  const pts: string[] = [];
  for (let x = -100; x <= 1700; x += 40) {
    const y = 300 + k * 26 + Math.sin(x / 210 + k * 0.55) * (70 - k * 2) + Math.sin(x / 90 + k) * 12;
    pts.push(`${x},${y.toFixed(1)}`);
  }
  return 'M' + pts.join(' L');
};
const contours = Array.from({ length: 16 }, (_, k) => contour(k - 8));

const variants = [
  {
    id: 'A',
    name: 'Nisip și cerneală',
    note: 'Tonuri calde, ca pagina-model: fundal nisip, text aproape negru, accent cărămiziu și verde salvie. Panglici care se mișcă lent pe fundal.',
    bg: '#ECE4D2', ink: '#1d1b16', muted: '#5b5547', accent: '#b8541e', accent2: '#6b7b5c', btnText: '#fff',
    swatches: ['#ECE4D2', '#1d1b16', '#b8541e', '#6b7b5c', '#f7f2e7'],
    kind: 'waves',
  },
  {
    id: 'B',
    name: 'Bleumarin rafinat',
    note: 'Culorile de acum, mai curate: bleumarin adânc și portocaliu. Pe fundal, curbe de nivel ca pe un plan topografic, care alunecă încet.',
    bg: '#0b1626', ink: '#ffffff', muted: 'rgba(255,255,255,.62)', accent: '#e08a1e', accent2: '#5b8fd0', btnText: '#fff',
    swatches: ['#0b1626', '#13243b', '#e08a1e', '#5b8fd0', '#ffffff'],
    kind: 'contour',
  },
  {
    id: 'C',
    name: 'Grafit și galben de marcaj',
    note: 'Gri închis, ca asfaltul, cu galbenul marcajelor rutiere. Fundalul e o fotografie reală a unui proiect, care se apropie foarte lent.',
    bg: '#121417', ink: '#ffffff', muted: 'rgba(255,255,255,.65)', accent: '#f2c12e', accent2: '#9aa3ad', btnText: '#121417',
    swatches: ['#121417', '#2a2e33', '#f2c12e', '#9aa3ad', '#ffffff'],
    kind: 'photo',
  },
  {
    id: 'D',
    name: 'Alb tehnic',
    note: 'Luminos, ca o planșă: alb-gri, text bleumarin, accent albastru de proiect. Pe fundal, pete de culoare foarte fine care se mută lent.',
    bg: '#f4f6f9', ink: '#0f1b2d', muted: '#566275', accent: '#1f5fbf', accent2: '#e08a1e', btnText: '#fff',
    swatches: ['#f4f6f9', '#0f1b2d', '#1f5fbf', '#e08a1e', '#ffffff'],
    kind: 'mesh',
  },
];

const photos = [
  { n: 1, src: '/img/hero-bg.webp', label: 'Actuala: șantier de autostradă, din dronă' },
  { n: 2, src: '/img/projects/vacari-pasaj.webp', label: 'Pasajul „Clubul Văcarilor”, Baia Mare (proiectul tău)' },
  { n: 3, src: '/img/projects/pod%20gogosu.jpg', label: 'Podul suspendat Gogoșu, Dunăre (proiectul tău)' },
  { n: 4, src: '/img/projects/craiova-santier.webp', label: 'Casetarea canalului, Craiova (proiectul tău)' },
  { n: 5, src: '/img/projects/POD%20LUGOJ.jpg', label: 'Podul de Fier, Lugoj (proiectul tău)' },
  { n: 6, src: '/img/projects/NOI.jpg', label: 'Drum național noaptea, din dronă' },
];
---

<Layout title="Variante culori și fundal" noindex>
  <main class="bg-white">
    <section class="container pt-10 pb-6">
      <p class="text-accent-600 text-[13px] font-semibold uppercase tracking-widest">Pagină de probă, nu e publică</p>
      <h1 class="text-[30px] md:text-[42px] font-heading font-extrabold text-brand-800 mt-2">Alege culorile și fundalul</h1>
      <p class="text-steel-500 text-[16px] mt-3 max-w-3xl">
        Mai jos sunt patru variante pentru partea de sus a primei pagini, cu textele de acum. Fiecare are paleta ei de culori și un fundal care se mișcă lent.
        La final sunt fotografiile din care poți alege. Spune-mi litera variantei și numărul pozei (de exemplu „B cu poza 2”).
        Se pot și combina: culorile dintr-o variantă cu fundalul din alta.
      </p>
    </section>

    {variants.map((v) => (
      <section class="pb-12">
        <div class="container mb-4 flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="font-heading font-extrabold text-[24px] text-brand-800">Varianta {v.id}: {v.name}</h2>
            <p class="text-steel-500 text-[15px] mt-1 max-w-2xl">{v.note}</p>
          </div>
          <div class="flex gap-1.5">
            {v.swatches.map((c) => <span class="w-8 h-8 rounded-full border border-black/10" style={`background:${c}`} title={c} />)}
          </div>
        </div>

        <div class="hero-demo relative overflow-hidden mx-3 md:mx-6 rounded-[28px]" style={`--bg:${v.bg};--ink:${v.ink};--muted:${v.muted};--accent:${v.accent};--accent2:${v.accent2};--btn:${v.btnText};background:var(--bg)`}>
          {v.kind === 'waves' && (
            <div class="absolute inset-0" aria-hidden="true">
              <svg class="wave w1" viewBox="0 0 1600 600" preserveAspectRatio="none"><path d="M-100 420 C 300 250, 600 560, 1000 380 S 1600 300, 1800 420 L 1800 700 L -100 700 Z" fill="var(--accent2)" opacity=".28" /></svg>
              <svg class="wave w2" viewBox="0 0 1600 600" preserveAspectRatio="none"><path d="M-100 300 C 250 470, 650 160, 1050 330 S 1500 520, 1800 300 L 1800 700 L -100 700 Z" fill="#d9b779" opacity=".35" /></svg>
              <svg class="wave w3" viewBox="0 0 1600 600" preserveAspectRatio="none"><path d="M-100 520 C 400 380, 800 620, 1200 470 S 1650 420, 1800 520 L 1800 700 L -100 700 Z" fill="var(--accent)" opacity=".14" /></svg>
            </div>
          )}
          {v.kind === 'contour' && (
            <svg class="absolute inset-0 w-full h-full contour" viewBox="0 0 1600 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <g fill="none" stroke="var(--accent2)" stroke-width="1.2" opacity=".5">
                {contours.map((d, i) => <path d={d} opacity={i % 4 === 0 ? 0.9 : 0.45} />)}
              </g>
            </svg>
          )}
          {v.kind === 'photo' && (
            <div class="absolute inset-0" aria-hidden="true">
              <img src="/img/projects/vacari-pasaj.webp" alt="" class="kenburns absolute inset-0 w-full h-full object-cover" />
              <div class="absolute inset-0" style="background:linear-gradient(90deg, rgba(18,20,23,.94) 0%, rgba(18,20,23,.75) 45%, rgba(18,20,23,.25) 100%)"></div>
            </div>
          )}
          {v.kind === 'mesh' && (
            <div class="absolute inset-0" aria-hidden="true">
              <span class="blob b1" style="background:var(--accent)"></span>
              <span class="blob b2" style="background:var(--accent2)"></span>
              <span class="blob b3" style="background:#7fb3e6"></span>
            </div>
          )}

          <div class="relative px-6 md:px-16 py-16 md:py-24 max-w-3xl">
            <p class="text-[13px] font-semibold uppercase tracking-[0.2em]" style="color:var(--accent)">Mario Engineering Design</p>
            <h3 class="font-heading font-extrabold leading-[1.04] tracking-[-0.03em] text-[40px] md:text-[64px] mt-4" style="color:var(--ink)">
              Proiectăm cu <span style="color:var(--accent)">responsabilitate</span> pentru comunități.
            </h3>
            <p class="text-[17px] md:text-[19px] leading-relaxed mt-5 max-w-xl" style="color:var(--muted)">
              Servicii integrate de proiectare (CFDP): drumuri, poduri, pasaje, pasarele, lucrări de sprijin și consolidări pentru toate fazele de proiectare.
            </p>
            <div class="flex flex-wrap gap-3 mt-8">
              <span class="inline-flex items-center px-7 py-3.5 rounded-full font-semibold text-[15px]" style="background:var(--accent);color:var(--btn)">Discută proiectul tău →</span>
              <span class="inline-flex items-center px-7 py-3.5 rounded-full font-semibold text-[15px] border" style="color:var(--ink);border-color:color-mix(in srgb, var(--ink) 25%, transparent)">Vezi portofoliu</span>
            </div>
          </div>
        </div>
      </section>
    ))}

    <section class="container pb-20">
      <h2 class="font-heading font-extrabold text-[24px] text-brand-800">Fotografii pentru prima pagină</h2>
      <p class="text-steel-500 text-[15px] mt-1 max-w-2xl">
        O fotografie dintr-un proiect al tău e mai convingătoare decât una generică. Dacă ai o poză mai bună (de preferat orizontală, din dronă), urc-o în folderul proiectului pe GitHub și o folosesc.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
        {photos.map((p) => (
          <figure class="rounded-2xl overflow-hidden border border-steel-100 bg-white">
            <div class="relative aspect-[16/9]">
              <img src={p.src} alt={p.label} class="w-full h-full object-cover" loading="lazy" />
              <span class="absolute top-3 left-3 w-9 h-9 rounded-full bg-white/95 text-brand-800 font-heading font-extrabold flex items-center justify-center shadow">{p.n}</span>
            </div>
            <figcaption class="p-4 text-[14px] text-steel-600">{p.label}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero-demo { min-height: 520px; isolation: isolate; }
  .wave { position: absolute; inset: -10% -20%; width: 140%; height: 120%; will-change: transform; }
  .w1 { animation: drift1 26s ease-in-out infinite alternate; }
  .w2 { animation: drift2 32s ease-in-out infinite alternate; }
  .w3 { animation: drift1 40s ease-in-out infinite alternate-reverse; }
  @keyframes drift1 { from { transform: translate3d(-4%, 0, 0) rotate(-1deg); } to { transform: translate3d(4%, -3%, 0) rotate(1.5deg); } }
  @keyframes drift2 { from { transform: translate3d(5%, 2%, 0) rotate(1deg); } to { transform: translate3d(-5%, -2%, 0) rotate(-1deg); } }

  .contour { animation: slide 45s linear infinite alternate; }
  @keyframes slide { from { transform: translate3d(-3%, 0, 0) scale(1.08); } to { transform: translate3d(3%, -2%, 0) scale(1.08); } }

  .kenburns { animation: kb 24s ease-in-out infinite alternate; transform-origin: 70% 50%; }
  @keyframes kb { from { transform: scale(1); } to { transform: scale(1.09) translate3d(-1.5%, -1%, 0); } }

  .blob { position: absolute; width: 46vw; height: 46vw; max-width: 620px; max-height: 620px; border-radius: 9999px; filter: blur(90px); opacity: .22; will-change: transform; }
  .b1 { top: -20%; right: -5%; animation: float1 22s ease-in-out infinite alternate; }
  .b2 { bottom: -35%; right: 25%; opacity: .16; animation: float2 28s ease-in-out infinite alternate; }
  .b3 { top: 10%; left: 40%; opacity: .14; animation: float1 34s ease-in-out infinite alternate-reverse; }
  @keyframes float1 { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-12%, 10%, 0); } }
  @keyframes float2 { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(14%, -12%, 0); } }

  @media (prefers-reduced-motion: reduce) {
    .wave, .contour, .kenburns, .blob { animation: none; }
  }
</style>
