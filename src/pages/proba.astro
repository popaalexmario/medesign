---
// Previzualizare: varianta C (grafit + galben de marcaj) aplicată pe partea de
// sus a primei pagini, cu două fotografii. Pagină ascunsă (noindex, fără sitemap).
// Textele sunt cele de pe prima pagină actuală.
import Layout from '../layouts/Layout.astro';

const options = [
  { n: 6, src: '/img/projects/NOI.jpg', label: 'Poza 6: drum național noaptea, din dronă', origin: '50% 50%' },
  { n: 2, src: '/img/projects/vacari-pasaj.webp', label: 'Poza 2: pasajul „Clubul Văcarilor”, Baia Mare', origin: '70% 50%' },
];

const services = [
  { t: 'Proiectare drumuri și platforme', d: 'Drumuri comunale, județene și naționale, intersecții, parcări.' },
  { t: 'Proiectare poduri, pasaje, pasarele', d: 'Structuri de traversare rutiere și pietonale.' },
  { t: 'Lucrări de sprijin și consolidări', d: 'Ziduri de sprijin, versanți, taluzuri.' },
];
---

<Layout title="Varianta C" noindex>
  <main class="vc">
    <div class="bg-[#121417] text-white/70 text-center text-[13px] py-2.5 px-4">
      Previzualizare, nu e publică. Mai jos sunt două versiuni ale primei pagini în varianta C. Derulează ca să le vezi pe amândouă.
    </div>

    {options.map((o) => (
      <section class="relative">
        <div class="bg-[#f2c12e] text-[#121417] text-center font-heading font-extrabold text-[15px] py-2">
          Varianta C cu {o.label}
        </div>

        <div class="relative min-h-[100svh] overflow-hidden bg-[#121417] flex flex-col">
          <img src={o.src} alt="" class="kb absolute inset-0 w-full h-full object-cover" style={`transform-origin:${o.origin}`} />
          <div class="absolute inset-0" style="background:linear-gradient(90deg, rgba(18,20,23,.95) 0%, rgba(18,20,23,.78) 42%, rgba(18,20,23,.30) 100%)"></div>
          <div class="absolute inset-x-0 bottom-0 h-40" style="background:linear-gradient(0deg, #121417, transparent)"></div>

          <!-- bara de sus, ca pe site -->
          <div class="relative container flex items-center justify-between h-20">
            <div>
              <span class="font-heading font-bold text-xl text-white">ME Design</span>
              <span class="hidden sm:block text-[11px] text-white/50 font-medium tracking-wider uppercase -mt-1">Proiectare Infrastructură</span>
            </div>
            <div class="hidden lg:flex items-center gap-8 text-[15px] font-medium text-white/75">
              <span>Servicii ⌄</span><span>Portofoliu</span><span>Blog</span><span>Despre noi</span><span>Contact</span>
              <span class="text-[13px] font-semibold border border-white/25 rounded-full px-3 py-1.5">EN</span>
              <span class="bg-[#f2c12e] text-[#121417] px-5 py-2 rounded-full text-[14px] font-semibold">Solicită ofertă</span>
            </div>
            <span class="lg:hidden text-white/80 text-2xl">☰</span>
          </div>

          <div class="relative container flex-1 flex flex-col justify-center pb-16 pt-6">
            <div class="max-w-2xl">
              <h1 class="font-heading font-extrabold text-white leading-[1.04] tracking-[-0.03em] text-[42px] md:text-[64px] lg:text-[76px]">
                Proiectăm cu <span class="text-[#f2c12e]">responsabilitate</span> pentru comunități.
              </h1>
              <p class="text-white/65 text-[16px] md:text-[20px] leading-relaxed mt-6 max-w-xl">
                Servicii integrate de proiectare (CFDP): drumuri, poduri, pasaje, pasarele, lucrări de sprijin și consolidări pentru toate fazele de proiectare.
              </p>
              <div class="flex flex-col sm:flex-row gap-4 mt-10">
                <span class="inline-flex items-center justify-center gap-2 bg-[#f2c12e] text-[#121417] px-8 py-4 rounded-full font-semibold text-[15px]">Discută proiectul tău →</span>
                <span class="inline-flex items-center justify-center bg-white/10 backdrop-blur text-white px-8 py-4 rounded-full font-semibold text-[15px] border border-white/20">Vezi portofoliu</span>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4 mt-12 max-w-xl">
              <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-5 text-center">
                <div class="text-[30px] md:text-[40px] font-heading font-extrabold text-white">2018</div>
                <div class="text-white/45 text-[13px] font-medium mt-1">Pe piață din</div>
              </div>
              <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-5 text-center">
                <div class="text-[30px] md:text-[40px] font-heading font-extrabold text-white">200+</div>
                <div class="text-white/45 text-[13px] font-medium mt-1">Proiecte finalizate</div>
              </div>
            </div>
          </div>
        </div>

        <!-- cum arată secțiunea următoare în aceeași paletă -->
        <div class="bg-[#f4f4f2] py-16">
          <div class="container">
            <div class="text-center max-w-2xl mx-auto mb-8">
              <span class="text-[#b8860b] font-semibold text-[13px] uppercase tracking-widest">Ce facem</span>
              <h2 class="text-[30px] md:text-[42px] font-heading font-bold text-[#121417] mt-3">Servicii de proiectare complete</h2>
            </div>
            <div class="grid md:grid-cols-3 gap-5">
              {services.map((s) => (
                <div class="bg-white rounded-2xl p-6 border border-black/5">
                  <div class="w-12 h-12 rounded-xl bg-[#121417] flex items-center justify-center">
                    <span class="w-5 h-1.5 rounded-full bg-[#f2c12e]"></span>
                  </div>
                  <h3 class="font-heading font-bold text-[18px] text-[#121417] mt-4">{s.t}</h3>
                  <p class="text-[#5a6068] text-[14px] mt-2">{s.d}</p>
                  <span class="inline-block text-[#b8860b] font-semibold text-[14px] mt-3">Detalii →</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))}
  </main>
</Layout>

<style>
  .kb { animation: kb 24s ease-in-out infinite alternate; }
  @keyframes kb { from { transform: scale(1); } to { transform: scale(1.09) translate3d(-1.5%, -1%, 0); } }
  @media (prefers-reduced-motion: reduce) { .kb { animation: none; } }
</style>
