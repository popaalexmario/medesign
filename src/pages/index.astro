---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const stats = [
  { fixed: '2018', label: 'Pe piață din', icon: '📐' },
  { value: 200, suffix: '+', label: 'Proiecte finalizate', icon: '🏗️' },
];

const services = [
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>`,
    title: 'Proiectare drumuri și platforme',
    desc: 'Documentații tehnice complete pentru drumuri comunale, județene și naționale — de la studii topografice, geotehnice, de trafic și gospodărirea apelor, până la proiectul tehnic de execuție, verificarea de proiect și asistența tehnică pe șantier.',
    href: '/servicii#proiectare-drumuri',
    color: 'from-blue-500 to-blue-700',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 17h18M3 17V9a2 2 0 012-2h4m10 10V9a2 2 0 00-2-2h-4m-4 0V5m0 2v10m0-10h4m-4 0H7" /></svg>`,
    title: 'Proiectare poduri, pasaje, pasarele',
    desc: 'Documentații tehnice complete pentru poduri, pasaje și pasarele — de la studii topografice, hidrologice și geotehnice, până la proiectul tehnic de execuție, verificarea de proiect și asistența tehnică pe șantier.',
    href: '/servicii#proiectare-poduri',
    color: 'from-emerald-500 to-emerald-700',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0H5m14 0h2m-2 0h-2M5 21H3m2 0h2m0-16h6m-6 4h6m-6 4h6" /></svg>`,
    title: 'Proiectare lucrări de sprijin și consolidări',
    desc: 'Documentații tehnice complete pentru lucrări de sprijin și consolidare — de la studii geotehnice, expertiză tehnică și calcule de stabilitate, până la proiectul tehnic de execuție, verificarea de proiect și asistența tehnică pe șantier.',
    href: '/servicii#lucrari-sprijin-consolidari',
    color: 'from-amber-500 to-amber-700',
  },
];

const process = [
  { step: '01', title: 'Analiză', desc: 'Evaluăm cerințele proiectului, studiem amplasamentul și identificăm soluțiile optime.', icon: '🔍' },
  { step: '02', title: 'Proiectare', desc: 'Elaborăm documentația tehnică completă cu respectarea tuturor normativelor în vigoare.', icon: '📐' },
  { step: '03', title: 'Sprijin obținere avize', desc: 'Întocmim documentații pentru obținerea avizelor și acordurilor necesare de la autoritățile competente în concordanță cu Certificatul de Urbanism.', icon: '📋' },
  { step: '04', title: 'Livrare', desc: 'Predăm proiectul finalizat și oferim suport pe toată durata implementării.', icon: '🚀' },
];

const reasons = [
  { icon: '🏗️', title: 'Experiență dovedită', desc: 'Peste 8 ani în proiectarea infrastructurii, cu peste 200 de proiecte livrate.' },
  { icon: '📋', title: 'Documentație completă', desc: 'Proiecte tehnice conforme cu legislația în vigoare, gata pentru autorizare și licitații.' },
  { icon: '⏱️', title: 'Respectăm termenele', desc: 'Livrare la termen, fără surprize. Planificare riguroasă și comunicare constantă.' },
  { icon: '🤝', title: 'Partener de încredere', desc: 'Colaborăm strâns cu autoritățile locale, constructorii și beneficiarii finali.' },
];
---

<style is:global>
  #hero-content {
    padding-top: 6.5rem; /* 104px: header 80px + 24px breathing room */
  }
  @media (min-width: 768px) {
    #hero-content {
      padding-top: 10rem;
    }
  }
</style>

<Layout title="Proiectare Infrastructură">
  <Header />

  <!-- HERO - Real photo + animated blueprint overlay -->
  <section class="relative min-h-screen flex items-start md:items-center overflow-hidden" id="hero" style="min-height: 100vh; min-height: 100svh">
    <!-- Fotografie de fundal (varianta C): se apropie foarte lent. -->
    <div class="absolute inset-0 overflow-hidden">
      <img src="/img/hero-noapte.webp" srcset="/img/hero-noapte-800.webp 800w, /img/hero-noapte.webp 1600w" sizes="100vw" fetchpriority="high" decoding="async" alt="Drum național cu pasaj rutier noaptea, fotografie aeriană" class="hero-kb absolute inset-0 w-full h-full object-cover" id="hero-bg" />
    </div>
    <div class="absolute inset-0" style="background:linear-gradient(90deg, rgba(18,20,23,.95) 0%, rgba(18,20,23,.78) 42%, rgba(18,20,23,.30) 100%)"></div>
    <div class="absolute inset-x-0 bottom-0 h-40" style="background:linear-gradient(0deg, #121417, transparent)"></div>

    <!-- Content -->
    <div id="hero-content" class="container relative z-[4] pb-20">
      <div class="max-w-2xl">
        <h1 class="text-[42px] md:text-[60px] lg:text-[80px] font-heading font-extrabold text-white leading-[1.05] mb-6">
          Proiectăm cu
          <span class="relative inline-block mb-4">
            <span class="text-accent-400">responsabilitate</span>
            <svg class="absolute -bottom-6 left-0 w-full" viewBox="0 0 200 12" fill="none">
              <path d="M2 10C50 2 150 2 198 10" stroke="#f2c12e" stroke-width="3" stroke-linecap="round"
                stroke-dasharray="200" stroke-dashoffset="200"
                class="animate-draw-path" style="animation-delay: 1s; animation-duration: 1.5s" />
            </svg>
          </span>
          <br />pentru comunități.
        </h1>

        <p class="text-white/60 text-[16px] md:text-[20px] max-w-xl leading-relaxed mb-10">
          Servicii integrate de proiectare (CFDP): drumuri, poduri, pasaje, pasarele, lucrări de sprijin și consolidări pentru toate fazele de proiectare.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="group inline-flex items-center justify-center gap-2 bg-accent-500 text-brand-800 px-8 py-4 rounded-full font-semibold text-[15px] hover:bg-accent-400 transition-all relative overflow-hidden">
            <span class="relative z-10">Discută proiectul tău</span>
            <svg class="w-4 h-4 relative z-10 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/portofoliu" class="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm text-white px-8 py-4 rounded-full font-semibold text-[15px] border border-white/20 hover:bg-white/20 transition-all">
            Vezi portofoliu
          </a>
        </div>
      </div>

      <!-- Cifrele (varianta C): o pastilă translucidă, fără casete și iconițe. -->
      <div class="mt-10 inline-flex flex-wrap items-center rounded-full bg-black/35 backdrop-blur-md border border-white/10 px-2 py-2">
        <span class="px-4 md:px-5 text-white whitespace-nowrap"><span class="font-heading font-extrabold text-[20px] md:text-[22px]">2018</span> <span class="text-white/55 text-[13px] ml-1">pe piață din</span></span>
        <span class="w-px h-7 bg-white/20"></span>
        <span class="px-4 md:px-5 text-white whitespace-nowrap"><span class="font-heading font-extrabold text-[20px] md:text-[22px] text-accent-500">200+</span> <span class="text-white/55 text-[13px] ml-1">proiecte finalizate</span></span>
      </div>
    </div>
  </section>

  <!-- SERVICII with 3D tilt cards -->
  <section class="section-padding bg-page-alt relative overflow-hidden" id="servicii">
    <!-- Background decoration -->
    <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-brand-500/3 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-accent-500/3 rounded-full blur-[80px]"></div>

    <div class="container relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <span class="text-accent-600 font-semibold text-[13px] uppercase tracking-widest" data-aos="fade-up">Ce facem</span>
        <h2 class="text-[32px] md:text-[44px] font-heading font-bold text-brand-800 mt-3" data-aos="fade-up" data-aos-delay="50">
          Servicii de proiectare complete
        </h2>
        <p class="text-steel-500 text-[16px] mt-4 leading-relaxed" data-aos="fade-up" data-aos-delay="100">
          Oferim soluții complete de proiectare infrastructură, de la concept la implementare.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {services.map((service, i) => (
          <a href={service.href} class="group tilt-card glass-card rounded-2xl p-5 relative overflow-hidden" data-aos="fade-up" data-aos-delay={i * 100}>
            <div class={`absolute top-0 right-0 w-32 h-32 bg-gradient-to-br ${service.color} opacity-0 group-hover:opacity-10 rounded-full blur-[40px] transition-opacity duration-500 -translate-y-8 translate-x-8`}></div>
            <div class="tilt-inner relative z-10">
              <div class="w-14 h-14 bg-brand-500/10 rounded-xl flex items-center justify-center text-brand-500 group-hover:bg-accent-500 group-hover:text-brand-800 transition-all duration-300 group-hover:scale-110 group-hover:rotate-3" set:html={service.icon} />
              <h3 class="font-heading font-bold text-[18px] text-brand-800 mt-3 group-hover:text-accent-600 transition-colors">{service.title}</h3>
              <p class="text-steel-500 text-[14px] mt-2 leading-relaxed">{service.desc}</p>
              <div class="flex items-center gap-1 text-accent-600 font-semibold text-[14px] mt-3 translate-x-0 group-hover:translate-x-2 transition-transform">
                Detalii
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCES with animated timeline -->
  <section class="section-padding bg-brand-900 text-white relative overflow-hidden">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <span class="text-accent-400 font-semibold text-[13px] uppercase tracking-widest" data-aos="fade-up">Cum lucrăm</span>
        <h2 class="text-[32px] md:text-[44px] font-heading font-bold text-white mt-3" data-aos="fade-up" data-aos-delay="50">
          Proces transparent, rezultate predictibile
        </h2>
      </div>

      <!-- Timeline desktop -->
      <div class="hidden md:block relative mb-8">
        <div class="absolute top-12 left-[12%] right-[12%] h-0.5 bg-white/10 rounded-full overflow-hidden">
          <div class="h-full bg-gradient-to-r from-accent-500 via-white/40 to-accent-500 rounded-full timeline-progress" style="width: 0%"></div>
        </div>
      </div>

      <div class="grid md:grid-cols-4 gap-8">
        {process.map((item, i) => (
          <div class="relative process-step" data-aos="fade-up" data-aos-delay={i * 150}>
            <div class="text-center md:text-left">
              <div class="relative inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-white/5 border border-white/10 mb-5 mx-auto md:mx-0">
                <span class="text-[28px]">{item.icon}</span>
                <span class="absolute -top-2 -right-2 w-7 h-7 rounded-lg bg-accent-500 text-brand-800 text-[11px] font-bold flex items-center justify-center shadow-lg shadow-accent-500/30">{item.step}</span>
              </div>
              <h3 class="font-heading font-bold text-[18px] text-white">{item.title}</h3>
              <p class="text-white/50 text-[14px] mt-3 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HARTA ROMANIA -->
  <section class="section-padding bg-page" id="harta">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-6" data-aos="fade-up">
        <span class="text-accent-600 font-semibold text-[13px] uppercase tracking-widest">Prezență națională</span>
        <h2 class="text-[32px] md:text-[44px] font-heading font-bold text-brand-800 mt-3">
          Proiecte în toată România
        </h2>
        <p class="text-steel-500 text-[16px] mt-4">
          Am realizat proiecte de infrastructură în toate colțurile țării.
        </p>
      </div>
      <div id="romania-map" class="relative w-full rounded-2xl overflow-hidden shadow-lg border border-steel-100 bg-steel-50" style="height: 525px;" data-aos="fade-up" data-aos-delay="100"></div>
    </div>
  </section>

  <script is:inline>
