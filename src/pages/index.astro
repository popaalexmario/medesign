    function initMap() {
      if (!window.L || !document.getElementById('romania-map')) return;

      var map = L.map('romania-map', {
        center: [45.9, 24.8],
        zoom: 7,
        zoomControl: true,
        scrollWheelZoom: false,
      });

      // Dalele vin prin domeniul propriu (functions/tiles), nu direct de la OSM.
      L.tileLayer('/tiles/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      var pinSvg = function(color) {
        return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 42" width="32" height="42">' +
          '<path d="M16 0C9.373 0 4 5.373 4 12c0 9 12 28 12 28S28 21 28 12C28 5.373 22.627 0 16 0z" fill="' + color + '" stroke="#fff" stroke-width="2"/>' +
          '<circle cx="16" cy="12" r="5" fill="#fff"/>' +
          '</svg>';
      };

      projects.forEach(function(p) {
        var icon = L.divIcon({
          html: pinSvg('#121417'),
          className: '',
          iconSize: [32, 42],
          iconAnchor: [16, 42],
          popupAnchor: [0, -44],
        });

        var cats = p.categories.map(function(c) {
          return '<span style="background:#12141712;color:#121417;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;">' + c + '</span>';
        }).join(' ');

        var popup = '<div style="font-family:\'Plus Jakarta Sans\',sans-serif;min-width:220px;max-width:280px;">' +
          (p.image ? '<img src="' + p.image + '" alt="' + p.title + '" style="width:100%;height:140px;object-fit:cover;border-radius:8px;margin-bottom:8px;display:block;" />' : '') +
          '<div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:6px;">' + cats +
          '<span style="background:#f2c12e33;color:#6e4e00;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;">' + p.faza + '</span>' +
          '</div>' +
          '<strong style="font-size:14px;color:#0a1628;line-height:1.3;display:block;">' + p.title + '</strong>' +
          '<p style="font-size:12px;color:#64748b;margin-top:4px;">📍 ' + p.location + '</p>' +
          '<p style="font-size:12px;color:#94a3b8;margin-top:2px;">📅 ' + p.year + '</p>' +
          '<a href="/portofoliu/' + p.slug + '/" style="display:inline-flex;align-items:center;gap:4px;margin-top:10px;background:#121417;color:#fff;padding:6px 14px;border-radius:99px;font-size:12px;font-weight:600;text-decoration:none;">Vezi proiect →</a>' +
          '</div>';

        L.marker([p.lat, p.lng], { icon: icon })
          .bindPopup(popup, { maxWidth: 280 })
          .addTo(map);
      });

      // Pulse animation on markers
      var style = document.createElement('style');
      style.textContent = '.leaflet-div-icon { background: none !important; border: none !important; } ' +
        '.leaflet-div-icon svg { filter: drop-shadow(0 4px 8px rgba(30,58,95,0.4)); transition: transform 0.2s; } ' +
        '.leaflet-div-icon:hover svg { transform: scale(1.15); }';
      document.head.appendChild(style);
    }

    // Leaflet și dalele hărții vin de pe domeniul propriu, deci harta e mereu
    // afișată, fără consimțământ. Se încarcă abia când ajunge aproape de ecran.
    var started = false;
    function startMap() {
      if (started) return;
      started = true;
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/vendor/leaflet/leaflet.css';
      document.head.appendChild(css);
      var script = document.createElement('script');
      script.src = '/vendor/leaflet/leaflet.js';
      script.onload = initMap;
      document.head.appendChild(script);
    }
    var mapEl = document.getElementById('romania-map');
    if (mapEl && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries, obs) {
        if (entries[0].isIntersecting) { obs.disconnect(); startMap(); }
      }, { rootMargin: '600px' }).observe(mapEl);
    } else {
      startMap();
    }
  })();
  </script>

