---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { categoryEn, regionEn } from '../../../i18n/paths';
import { cardSrcset, CARD_SIZES } from '../../../utils/img';
import PhotoGrid from '../../../components/PhotoGrid.astro';
import { projectPhotos, type Photo } from '../../../utils/autoGallery';

export async function getStaticPaths() {
  const all = await getCollection('projects', ({ data }) => !data.draft);
  const en = await getCollection('projects-en');
  return all
    .filter((p) => en.some((e) => e.slug === p.slug))
    .map((project) => ({ params: { slug: project.slug }, props: { project, tr: en.find((e) => e.slug === project.slug)! } }));
}

type Props = { project: CollectionEntry<'projects'>; tr: CollectionEntry<'projects-en'> };

const { project, tr } = Astro.props;
const { Content } = await tr.render();
const ro = project.data;
const county = (j: string) => (j === 'București' ? 'Bucharest' : `${j} County`);
const cats = (c: string[]) => c.map((x) => categoryEn[x] ?? x);
const d = { ...ro, ...tr.data, judet: county(ro.judet), categories: cats(ro.categories) };

const enTitles = new Map((await getCollection('projects-en')).map((e) => [e.slug, e.data]));
const all = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((p) => enTitles.has(p.slug))
  .sort((a, b) => a.data.order - b.data.order);

const sameRegion = all.filter((p) => p.slug !== project.slug && p.data.region === d.region);
const sameCat = all.filter(
  (p) => p.slug !== project.slug && p.data.region !== d.region && p.data.categories.some((c) => ro.categories.includes(c))
);
const related = [...sameRegion, ...sameCat].slice(0, 3);

const url = `https://me-design.ro/en/portfolio/${project.slug}/`;
// Galeria din capul fișei: coperta, apoi imaginile existente din `gallery`
// (planșe, randări), apoi pozele urcate în poze/proiecte/<slug>/.
const uploaded = (await projectPhotos(project.slug))
  .filter((p) => p.name !== d.coverFrom)
  .map((p) => ({ ...p, caption: undefined }));
const gallery: Photo[] = [
  ...(d.image ? [{ thumb: d.image, full: d.image, fit: 'contain' as const }] : []),
  ...d.gallery.map((g) => {
    const item = typeof g === 'string' ? { src: g, caption: undefined } : g;
    const caption = item.caption === 'Planșă din proiect' ? 'Project drawing' : item.caption === 'Imagine din proiect' ? 'Project image' : undefined;
    return { thumb: item.src, full: item.src, caption, fit: 'contain' as const };
  }),
  ...uploaded,
];
// Coperta e de obicei o fotografie: o afișăm umplând cadrul.
if (gallery[0] && d.image && !/\.(png|svg)$/i.test(d.image)) gallery[0].fit = 'cover';

const metaDescription = (d.description.length < 110
  ? `${d.description.replace(/\.*$/, '')}. ${d.faza}. ${d.location}, ${d.year}. Design by ME Design.`
  : d.description).slice(0, 165);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': `${url}#project`,
    name: d.title,
    description: d.description,
    ...(d.image && { image: new URL(d.image, 'https://me-design.ro').href }),
    dateCreated: d.year,
    inLanguage: 'en',
    creator: { '@id': 'https://me-design.ro/#organization' },
    locationCreated: { '@type': 'Place', name: d.location, address: { '@type': 'PostalAddress', addressRegion: d.judet, addressCountry: 'RO' } },
    about: d.categories.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://me-design.ro/en/' },
      { '@type': 'ListItem', position: 2, name: 'Portfolio', item: 'https://me-design.ro/en/portfolio/' },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---

<Layout
  title={d.seoTitle ?? (d.title.length > 60 ? d.title.slice(0, 57).trimEnd() + '…' : d.title)}
  description={metaDescription}
  image={d.image}
  jsonLd={jsonLd}
>
  <Header />

  <section class="pt-28 pb-10 page-hero">
    <div class="container max-w-4xl">
      <nav class="flex items-center gap-2 text-white/50 text-[13px] mb-6 flex-wrap" aria-label="Breadcrumb">
        <a href="/en/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/en/portfolio" class="hover:text-white transition-colors">Portfolio</a>
        <span>/</span>
        <span>{regionEn[ro.region]}</span>
      </nav>

      <div class="flex items-center gap-2 flex-wrap mb-4">
        {d.categories.map((c) => (
          <span class="bg-white/10 text-white/80 px-3 py-1 rounded-full text-[12px] font-semibold">{c}</span>
        ))}
        <span class="bg-accent-500/20 text-accent-400 px-3 py-1 rounded-full text-[12px] font-semibold">Phase: {d.faza}</span>
      </div>

      <h1 class="text-[26px] md:text-[40px] font-heading font-extrabold text-white leading-tight">
        {d.title}
      </h1>

      <div class="flex items-center gap-4 text-white/55 text-[14px] mt-5 flex-wrap">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          {d.location}
        </span>
        <span>·</span>
        <span>{d.year}</span>
      </div>
    </div>
  </section>

  <section class="section-padding bg-page">
    <div class="container max-w-4xl">
      <PhotoGrid photos={gallery} alt={d.title} title={false} class="mb-8" />

      <div class="grid lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2">
          <div class="prose prose-lg max-w-none
                      prose-headings:font-heading prose-headings:text-brand-800
                      prose-h2:text-[22px] prose-h2:mt-8 prose-h2:mb-3
                      prose-p:text-steel-600 prose-p:text-[16px] prose-p:leading-relaxed
                      prose-li:text-steel-600 prose-li:marker:text-accent-500
                      prose-strong:text-brand-800
                      prose-a:text-accent-600 prose-a:font-semibold prose-a:no-underline hover:prose-a:underline">
            <Content />
          </div>

        </div>

        <aside class="space-y-5">
          <div class="bg-steel-50 border border-steel-100 rounded-2xl p-5">
            <h2 class="font-heading font-bold text-brand-800 text-[16px] mb-4">Project data</h2>
            <dl class="space-y-3 text-[14px]">
              <div>
                <dt class="text-steel-400 text-[12px] uppercase tracking-wide">Location</dt>
                <dd class="text-steel-700 font-medium mt-0.5">{d.location}</dd>
              </div>
              <div>
                <dt class="text-steel-400 text-[12px] uppercase tracking-wide">County</dt>
                <dd class="text-steel-700 font-medium mt-0.5">{d.judet}</dd>
              </div>
              {d.beneficiar && (
                <div>
                  <dt class="text-steel-400 text-[12px] uppercase tracking-wide">
                    {d.beneficiarPrin ? 'Final client' : 'Client'}
                  </dt>
                  <dd class="text-steel-700 font-medium mt-0.5">{d.beneficiar}</dd>
                  {d.beneficiarPrin && (
                    <dd class="text-steel-400 text-[12px] mt-0.5">{d.beneficiarPrin}</dd>
                  )}
                </div>
              )}
              <div>
                <dt class="text-steel-400 text-[12px] uppercase tracking-wide">Design phase</dt>
                <dd class="text-steel-700 font-medium mt-0.5">{d.faza}</dd>
              </div>
              <div>
                <dt class="text-steel-400 text-[12px] uppercase tracking-wide">Period</dt>
                <dd class="text-steel-700 font-medium mt-0.5">{d.year}</dd>
              </div>
              <div>
                <dt class="text-steel-400 text-[12px] uppercase tracking-wide">Type of works</dt>
                <dd class="text-steel-700 font-medium mt-0.5">{d.categories.join(', ')}</dd>
              </div>
            </dl>
          </div>

          <div class="bg-brand-900 rounded-2xl p-5 text-white">
            <h2 class="font-heading font-bold text-[16px] mb-2">Working on a similar project?</h2>
            <p class="text-white/60 text-[14px] mb-4">Send us the brief and we will tell you which design stages and studies it needs.</p>
            <a href="/en/contact" class="block text-center bg-accent-500 hover:bg-accent-400 text-brand-800 px-5 py-3 rounded-full font-semibold text-[14px] transition-all">
              Discuss your project
            </a>
          </div>

        </aside>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-padding bg-page-alt">
      <div class="container">
        <h2 class="text-[24px] md:text-[30px] font-heading font-bold text-brand-800 mb-7" data-aos="fade-up">
          Related projects
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          {related.map((p, i) => (
            <a href={`/en/portfolio/${p.slug}`} class="group bg-white rounded-2xl overflow-hidden border border-steel-100 hover:shadow-lg transition-all" data-aos="fade-up" data-aos-delay={i * 80}>
              <div class="aspect-[16/10] bg-steel-100 overflow-hidden">
                {p.data.image
                  ? <img src={p.data.image} srcset={cardSrcset(p.data.image)} sizes={CARD_SIZES} alt={enTitles.get(p.slug)!.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="400" height="250" />
                  : <div class="w-full h-full bg-gradient-to-br from-brand-700 to-brand-900" />}
              </div>
              <div class="p-5">
                <div class="flex items-center flex-wrap gap-2">
                  <span class="text-accent-600 text-[12px] font-semibold">{categoryEn[p.data.categories[0]] ?? p.data.categories[0]}</span>
                  <span class="px-2.5 py-0.5 rounded-full bg-accent-500/15 text-accent-700 text-[12px] font-semibold">Phase: {p.data.faza}</span>
                </div>
                <h3 class="font-heading font-bold text-[15px] text-brand-800 mt-1.5 leading-snug group-hover:text-accent-600 transition-colors">{enTitles.get(p.slug)!.title}</h3>
                <p class="text-steel-400 text-[13px] mt-1.5">{enTitles.get(p.slug)!.location}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Lightbox />
  <Footer />
</Layout>
