---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const values = [
  { icon: '🛡️', title: 'Responsabilitate', desc: 'Punem comunitatea și siguranța oamenilor înaintea comodității.' },
  { icon: '📐', title: 'Rigoare', desc: 'Nu presupunem. Calculăm, verificăm și demonstrăm.' },
  { icon: '🧠', title: 'Gândire inginerească', desc: 'Nu copiem soluții. Înțelegem problema și alegem soluția potrivită.' },
  { icon: '✍️', title: 'Asumare', desc: 'Putem pune numele nostru pe ceea ce proiectăm.' },
];
import LogoMarquee from '../components/LogoMarquee.astro';

// Diferențiatori: fiecare e susținut de proiecte și pagini existente pe site.
const diferentiatori = [
  {
    nr: '01',
    title: 'Proiectul complet, într-un singur contract',
    desc: 'Studii topografice, geotehnice, hidrologice și de trafic, expertiză tehnică și verificare de proiect, coordonate de noi. Nu cauți separat fiecare specialist.',
    href: '/servicii', link: 'Serviciile noastre',
  },
  {
    nr: '02',
    title: 'Rămânem pe șantier până la recepție',
    desc: 'Asigurăm asistența tehnică pe durata execuției: soluții pentru ce apare la săpătură, avizarea materialelor, prezență la fazele determinante.',
    href: '/portofoliu/dn7-versanti-valcea', link: 'Exemplu: DN7, defileul Oltului',
  },
  {
    nr: '03',
    title: 'De la comune la companii naționale',
    desc: 'Am lucrat pentru primării de comună și de municipiu, consilii județene, CNAIR, CFR și Hidroelectrica. Știm cum diferă cerințele fiecăruia.',
    href: '/portofoliu', link: 'Portofoliul',
  },
  {
    nr: '04',
    title: 'Lucrări pe care puțini le iau',
    desc: 'Poduri monument istoric, structuri metalice peste calea ferată electrificată, consolidări de versanți pe drumuri fără alternativă.',
    href: '/portofoliu/pod-fier-lugoj-timis', link: 'Exemplu: Podul de Fier, Lugoj',
  },
  {
    nr: '05',
    title: 'Documentații pe legislația la zi',
    desc: 'Lucrăm deja pe noul Cod al amenajării teritoriului, urbanismului și construcțiilor și scriem public despre ce schimbă el.',
    href: '/blog', link: 'Articolele noastre',
  },
  {
    nr: '06',
    title: 'Calitate certificată',
    desc: 'Sisteme de management certificate ISO 9001, ISO 14001 și ISO 45001 pentru calitate, mediu și securitate ocupațională.',
    href: '#certificari', link: 'Certificările',
  },
];

// Etapele unei colaborări.
const etape = [
  { title: 'Discutăm tema', desc: 'Pornim de la nevoia reală și de la amplasament. Îți spunem ce documentații sunt necesare și în ce ordine.' },
  { title: 'Studii și expertiză', desc: 'Topografie, geotehnică, hidrologie, trafic și, la construcțiile existente, expertiza tehnică.' },
  { title: 'Soluția și documentația', desc: 'SF sau DALI, apoi proiectul pentru autorizare și proiectul tehnic de execuție.' },
  { title: 'Avize și verificare', desc: 'Pregătim documentațiile pentru avize și coordonăm verificarea de proiect.' },
  { title: 'Asistență pe șantier', desc: 'Rămânem alături de beneficiar și constructor până la recepția lucrărilor.' },
];
---

<Layout title="Despre noi" description="Despre ME Design - echipă de profesioniști cu peste 8 ani experiență în proiectarea infrastructurii.">
  <Header />

  <section class="pt-28 pb-8 bg-gradient-to-br from-brand-900 to-brand-700">
    <div class="container">
      <span class="text-accent-400 font-semibold text-[13px] uppercase tracking-widest" data-aos="fade-up">Despre noi</span>
      <h1 class="text-[36px] md:text-[52px] font-heading font-extrabold text-white mt-3" data-aos="fade-up" data-aos-delay="50">
        Experiență și dedicare<br />în proiectare
      </h1>
    </div>
  </section>

  <section class="section-padding bg-white overflow-x-clip">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-8 items-center">
        <div data-aos="fade-right">
          <h2 class="text-[28px] md:text-[36px] font-heading font-bold text-brand-800">
            Cine suntem
          </h2>
          <div class="space-y-3 mt-4 text-steel-600 text-[15px] leading-relaxed">
            <p>
              <strong>Mario Engineering Design SRL</strong> este o companie de proiectare specializată în infrastructură rutieră și lucrări de artă, înființată în decembrie 2018.
            </p>
            <p>
              Cu peste 8 ani de experiență, am contribuit la dezvoltarea infrastructurii în numeroase localități din România, livrând proiecte tehnice complete pentru drumuri comunale, județene și naționale, poduri, pasaje, pasarele și lucrări de sprijin și consolidări.
            </p>
            <p>
              Fiecare proiect beneficiază de aceeași atenție la detaliu, respectând cele mai înalte standarde tehnice și legislația în vigoare.
            </p>
            <p>
              Compania este certificată conform standardelor internaționale <strong>ISO 9001 – Sisteme de Management al Calității</strong>, <strong>ISO 14001 – Sisteme de Management de Mediu</strong> și <strong>ISO 45001 – Sisteme de Management al Sănătății și Securității Ocupaționale</strong>.
            </p>
          </div>
          <div class="mt-5 p-4 bg-steel-50 rounded-2xl text-[14px] text-steel-500 space-y-1">
            <p><span class="font-semibold text-steel-700">Denumire:</span> Mario Engineering Design SRL</p>
            <p><span class="font-semibold text-steel-700">CUI:</span> 40290175</p>
            <p><span class="font-semibold text-steel-700">Data înființării:</span> 12 decembrie 2018</p>
            <p><span class="font-semibold text-steel-700">Adresă Sediu Social:</span> Str. Avionului 26, Et. 1, Ap. B, Sectorul 1, București</p>
          </div>
        </div>
        <div class="rounded-3xl overflow-hidden aspect-square" data-aos="fade-left">
          <img src="/img/projects/NOI.jpg" alt="Echipa ME Design" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-brand-900">
    <div class="container max-w-4xl">
      <div class="text-center mb-10" data-aos="fade-up">
        <span class="text-accent-400 font-semibold text-[13px] uppercase tracking-widest">Identitate</span>
        <h2 class="text-[28px] md:text-[40px] font-heading font-bold text-white mt-3">
          Misiunea echipei ME Design
        </h2>
      </div>
      <div class="space-y-6">
        <div class="border-l-4 border-accent-500 pl-6" data-aos="fade-up">
          <p class="text-white/85 text-[16px] leading-relaxed">
            Transformăm nevoile reale ale comunităților în infrastructură sigură, corectă și bine gândită, prin aplicarea responsabilă a cunoștințelor inginerești, a normelor și standardelor.
          </p>
        </div>
        <div class="border-l-4 border-accent-500/50 pl-6" data-aos="fade-up" data-aos-delay="80">
          <p class="text-white/70 text-[16px] leading-relaxed">
            Căutăm pentru fiecare proiect soluția optimă în raport cu nevoia, posibilitățile și resursele disponibile, anticipăm problemele și proiectăm cu gândul la modul în care infrastructura va fi folosită în realitate.
          </p>
        </div>
        <div class="border-l-4 border-accent-500/50 pl-6" data-aos="fade-up" data-aos-delay="160">
          <p class="text-white/70 text-[16px] leading-relaxed">
            Nu negociem niciodată siguranța. Ne asumăm ceea ce proiectăm și lucrăm astfel încât oamenii să poată folosi infrastructura firesc, fără ca greșelile de proiectare să le afecteze viața.
          </p>
        </div>
        <div class="border-l-4 border-accent-500/50 pl-6" data-aos="fade-up" data-aos-delay="240">
          <p class="text-white/70 text-[16px] leading-relaxed">
            Prin fiecare proiect, vrem să ridicăm standardul de calitate al proiectării și să construim o firmă de care atât clienții, cât și oamenii care lucrează în ea să poată fi mândri.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-10" data-aos="fade-up">
        <span class="text-accent-500 font-semibold text-[13px] uppercase tracking-widest">Diferențiatori</span>
        <h2 class="text-[28px] md:text-[40px] font-heading font-bold text-brand-800 mt-3">De ce ME Design</h2>
        <p class="text-steel-500 text-[16px] mt-3">Ce primești concret când lucrezi cu noi.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {diferentiatori.map((d, i) => (
          <div class="group relative bg-white border border-steel-100 rounded-2xl p-6 hover:border-accent-500/40 hover:shadow-xl hover:-translate-y-1 transition-all" data-aos="fade-up" data-aos-delay={(i % 3) * 80}>
            <span class="font-heading font-extrabold text-[40px] leading-none text-accent-500/20 group-hover:text-accent-500/40 transition-colors">{d.nr}</span>
            <h3 class="font-heading font-bold text-[18px] text-brand-800 mt-3">{d.title}</h3>
            <p class="text-steel-500 text-[14.5px] leading-relaxed mt-2">{d.desc}</p>
            <a href={d.href} class="inline-flex items-center gap-1.5 mt-4 text-accent-600 text-[14px] font-semibold hover:gap-2.5 transition-all">{d.link} <span aria-hidden="true">→</span></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-steel-50">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-7">
        <h2 class="text-[28px] md:text-[40px] font-heading font-bold text-brand-800" data-aos="fade-up">
          Valorile noastre
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((item, i) => (
          <div class="glass-card rounded-2xl p-4 text-center hover:shadow-lg transition-all" data-aos="fade-up" data-aos-delay={i * 80}>
            <span class="text-[40px]">{item.icon}</span>
            <h3 class="font-heading font-bold text-[16px] text-brand-800 mt-2">{item.title}</h3>
            <p class="text-steel-500 text-[13px] mt-1 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-10" data-aos="fade-up">
        <span class="text-accent-500 font-semibold text-[13px] uppercase tracking-widest">Proces</span>
        <h2 class="text-[28px] md:text-[40px] font-heading font-bold text-brand-800 mt-3">Cum lucrăm</h2>
        <p class="text-steel-500 text-[16px] mt-3">De la prima discuție până la recepția lucrării.</p>
      </div>
      <ol class="relative grid md:grid-cols-5 gap-6 md:gap-4">
        <div class="hidden md:block absolute top-6 left-[10%] right-[10%] h-0.5 bg-gradient-to-r from-accent-500/20 via-accent-500/60 to-accent-500/20" aria-hidden="true"></div>
        {etape.map((e, i) => (
          <li class="relative flex md:flex-col items-start md:items-center md:text-center gap-4 md:gap-0" data-aos="fade-up" data-aos-delay={i * 80}>
            <span class="relative z-10 w-12 h-12 shrink-0 rounded-full bg-accent-500 text-white font-heading font-bold text-[18px] flex items-center justify-center shadow-lg shadow-accent-500/30 ring-4 ring-white">{i + 1}</span>
            <div class="md:mt-4">
              <h3 class="font-heading font-bold text-[16px] text-brand-800">{e.title}</h3>
              <p class="text-steel-500 text-[14px] leading-relaxed mt-1.5">{e.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <LogoMarquee />

  <section id="certificari" class="section-padding bg-white scroll-mt-24">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-7">
        <h2 class="text-[28px] md:text-[40px] font-heading font-bold text-brand-800" data-aos="fade-up">
          Certificări
        </h2>
        <p class="text-steel-500 text-[16px] mt-3" data-aos="fade-up" data-aos-delay="50">
          Calitatea serviciilor noastre este atestată prin certificări internaționale recunoscute.
        </p>
      </div>
      <div class="flex flex-wrap justify-center items-center gap-10" data-aos="fade-up" data-aos-delay="100">
        <img src="/img/projects/ISO%209001.png" alt="ISO 9001 – Sisteme de Management al Calității" class="h-28 object-contain" />
        <img src="/img/projects/ISO%2014001.png" alt="ISO 14001 – Sisteme de Management de Mediu" class="h-28 object-contain" />
        <img src="/img/projects/ISO%2045001.png" alt="ISO 45001 – Sisteme de Management al Sănătății și Securității Ocupaționale" class="h-28 object-contain" />
      </div>
    </div>
  </section>

  <section class="section-padding bg-brand-900">
    <div class="container text-center" data-aos="fade-up">
      <h2 class="text-[28px] md:text-[36px] font-heading font-bold text-white">Vrei să lucrăm împreună?</h2>
      <p class="text-white/60 text-[16px] mt-3 max-w-md mx-auto">Contactează-ne pentru a discuta despre proiectul tău de infrastructură.</p>
      <a href="/contact" class="inline-flex items-center gap-2 mt-5 bg-accent-500 text-white px-8 py-4 rounded-full font-semibold text-[15px] hover:bg-accent-600 transition-all">
        Ia legătura cu noi
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
