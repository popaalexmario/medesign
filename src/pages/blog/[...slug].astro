---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const sameCategory = allPosts.filter(
  (p) => p.slug !== post.slug && p.data.category === post.data.category
);
const others = allPosts.filter((p) => p.slug !== post.slug && p.data.category !== post.data.category);
const related = [...sameCategory, ...others].slice(0, 3);

const readingTime = Math.max(1, Math.ceil(post.body.split(/\s+/).length / 200));
const toc = headings.filter((h) => h.depth === 2);

const url = `https://me-design.ro/blog/${post.slug}`;
const ogImage = post.data.image ?? '/img/og-default.jpg';

const fmtDate = (d: Date) =>
  d.toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.data.title,
    description: post.data.description,
    image: new URL(ogImage, 'https://me-design.ro').href,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    inLanguage: 'ro-RO',
    author: { '@id': 'https://me-design.ro/#organization' },
    publisher: { '@id': 'https://me-design.ro/#organization' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    ...(post.data.keywords.length > 0 && { keywords: post.data.keywords.join(', ') }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Acasă', item: 'https://me-design.ro' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://me-design.ro/blog' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  keywords={post.data.keywords}
  jsonLd={jsonLd}
>
  <Header />

  <section class="pt-28 pb-10 bg-gradient-to-br from-brand-900 to-brand-700">
    <div class="container max-w-3xl">
      <nav class="flex items-center gap-2 text-white/50 text-[13px] mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Acasă</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      </nav>

      <span class="inline-block bg-accent-500/20 text-accent-400 px-3 py-1 rounded-full text-[12px] font-semibold">
        {post.data.category}
      </span>

      <h1 class="text-[30px] md:text-[44px] font-heading font-extrabold text-white mt-4 leading-tight">
        {post.data.title}
      </h1>

      <div class="flex items-center gap-3 text-white/50 text-[14px] mt-5 flex-wrap">
        <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
        <span>·</span>
        <span>{readingTime} min citire</span>
        {post.data.updatedDate && (
          <>
            <span>·</span>
            <span>Actualizat {fmtDate(post.data.updatedDate)}</span>
          </>
        )}
      </div>
    </div>
  </section>

  <article class="section-padding bg-white">
    <div class="container max-w-3xl">
      {post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.imageAlt ?? post.data.title}
          class="w-full rounded-2xl object-cover max-h-[400px] mb-8"
          width="768"
          height="400"
        />
      )}

      {toc.length > 2 && (
        <nav class="bg-steel-50 border border-steel-100 rounded-2xl p-5 mb-8" aria-label="Cuprins">
          <p class="font-heading font-bold text-brand-800 text-[15px] mb-3">Cuprins</p>
          <ol class="space-y-2 list-decimal list-inside">
            {toc.map((h) => (
              <li class="text-[14px]">
                <a href={`#${h.slug}`} class="text-steel-600 hover:text-accent-600 transition-colors">
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div
        class="prose prose-lg max-w-none
               prose-headings:font-heading prose-headings:text-brand-800 prose-headings:scroll-mt-28
               prose-h2:text-[26px] prose-h2:mt-10 prose-h2:mb-4
               prose-h3:text-[20px] prose-h3:mt-7 prose-h3:mb-3
               prose-p:text-steel-600 prose-p:text-[16px] prose-p:leading-relaxed
               prose-li:text-steel-600 prose-li:text-[16px] prose-li:marker:text-accent-500
               prose-strong:text-brand-800
               prose-a:text-accent-600 prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
               prose-table:text-[15px] prose-th:bg-steel-50 prose-th:text-brand-800
               prose-td:border-steel-100 prose-th:border-steel-200
               prose-hr:border-steel-200 prose-hr:my-10
               prose-img:rounded-2xl"
      >
        <Content />
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section-padding bg-steel-50">
      <div class="container">
        <h2 class="text-[24px] md:text-[30px] font-heading font-bold text-brand-800 mb-7" data-aos="fade-up">
          Articole similare
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          {related.map((p, i) => (
            <a
              href={`/blog/${p.slug}`}
              class="group bg-white rounded-2xl overflow-hidden border border-steel-100 hover:shadow-lg transition-all flex flex-col"
              data-aos="fade-up"
              data-aos-delay={i * 80}
            >
              <div class="aspect-[16/10] bg-steel-100 overflow-hidden">
                {p.data.image ? (
                  <img
                    src={p.data.image}
                    alt={p.data.imageAlt ?? p.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                    width="400"
                    height="250"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-brand-700 to-brand-900" />
                )}
              </div>
              <div class="p-5 flex flex-col flex-1">
                <span class="text-accent-600 text-[12px] font-semibold">{p.data.category}</span>
                <h3 class="font-heading font-bold text-[16px] text-brand-800 mt-2 leading-snug group-hover:text-accent-600 transition-colors">
                  {p.data.title}
                </h3>
                <p class="text-steel-500 text-[13px] mt-2 leading-relaxed">{p.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-padding bg-brand-900">
    <div class="container text-center max-w-2xl" data-aos="fade-up">
      <h2 class="text-[26px] md:text-[34px] font-heading font-bold text-white">
        Ai un proiect de infrastructură?
      </h2>
      <p class="text-white/60 text-[16px] mt-3">
        Analizăm cerințele, îți spunem ce documentații sunt necesare și îți oferim o soluție completă.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 mt-6 bg-accent-500 text-white px-8 py-4 rounded-full font-semibold text-[15px] hover:bg-accent-600 transition-all"
      >
        Discută proiectul tău
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
